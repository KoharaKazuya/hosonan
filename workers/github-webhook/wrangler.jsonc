{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hosonan-github-webhook",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
  "queues": {
    "producers": [
      {
        "binding": "ARTICLE_RENDER_QUEUE",
        "queue": "hosonan-article-render",
      },
    ],
  },
  "d1_databases": [
    {
      "binding": "GITHUB_REGISTRY",
      "database_name": "hosonan-github-registry",
      "database_id": "d49db09c-502e-4252-b3a0-7cf3a47d4bb6",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REPO_SYNC_STATE",
        "class_name": "RepoSyncState",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RepoSyncState"],
    },
  ],
  "secrets": {
    "required": ["WEBHOOK_SECRET"],
  },
}
