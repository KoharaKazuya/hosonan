{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hosonan-router",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-02",
  "workers_dev": true,
  "services": [
    {
      "binding": "WEB",
      "service": "hosonan-web",
    },
    {
      "binding": "GITHUB_WEBHOOK",
      "service": "hosonan-github-webhook",
    },
  ],
}
