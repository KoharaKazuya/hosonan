{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hosonan-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
  "r2_buckets": [
    {
      "binding": "ARTICLES_BUCKET",
      "bucket_name": "hosonan-articles",
      "remote": true,
    },
  ],
}
