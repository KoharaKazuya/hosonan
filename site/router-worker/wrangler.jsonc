{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hosonan",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-02",
  "workers_dev": true,
  "services": [
    {
      "binding": "SITE_WORKER",
      "service": "hosonan-site-worker",
    },
    {
      "binding": "ARTICLE_WORKER",
      "service": "hosonan-article-worker",
    },
  ],
}
